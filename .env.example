# Copie para .env.local e preencha. Nunca faça commit de .env.local.
# Valores locais: rode `npx supabase status` depois de `npm run db:start`.

# URL pública da API do Supabase (local: http://127.0.0.1:54321)
NEXT_PUBLIC_SUPABASE_URL=
# Chave publicável (sb_publishable_...). Segura no navegador; o RLS protege os dados.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Chave secreta (sb_secret_...). SOMENTE servidor: lê definições de casos e estado das sessões.
SUPABASE_SECRET_KEY=
